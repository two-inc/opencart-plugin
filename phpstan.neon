parameters:
    level: 6
    # The supported floor (OpenCart 4.1 requires PHP 8.1).
    phpVersion: 80100
    paths:
        - admin
        - catalog
        - system
        - dev
        - tests
    bootstrapFiles:
        - dev/ci/phpstan-bootstrap.php
    # Real OpenCart sources at the supported floor (4.1.0.0), fetched by
    # `make phpstan` with a pinned checksum. The adapter's @property-read
    # annotations resolve against these.
    scanDirectories:
        - .cache/opencart/system/engine
        - .cache/opencart/system/library
        - .cache/opencart/admin/model
    ignoreErrors:
        # Core stubs take their collaborators now and read them once the
        # owning phase fills the method in.
        -
            identifier: property.onlyWritten
            path: system/library/core/*
            reportUnmatched: false
