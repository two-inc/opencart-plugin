# Copy to .env and fill in. The Makefile and docker compose both read it.

# Two merchant API key, stored by `make install` and `make configure`.
TWO_API_KEY=

# production, sandbox or staging. Defaults to staging for @two.inc gcloud
# accounts and sandbox for everyone else.
# TWO_ENVIRONMENT=sandbox

# 1 offers the staging environment in the admin (internal Two shops only).
# TWO_INTERNAL_ENVIRONMENTS=

# Local shop port.
# PORT=1238
