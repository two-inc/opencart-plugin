{% if two_order_id %}
<table class="table table-bordered">
  <tbody>
    <tr><td class="w-25">{{ text_two_order }}</td><td>{{ two_order_id }}</td></tr>
    <tr><td>{{ text_two_state }}</td><td>{{ two_order_state }}</td></tr>
  </tbody>
</table>
{% if invoice %}
<a href="{{ invoice }}" target="_blank" rel="noopener" class="btn btn-primary"><i class="fa-solid fa-file-pdf"></i> {{ button_invoice }}</a>
<div class="form-text">{{ help_invoice }}</div>
{% endif %}
{% else %}
<p>{{ text_no_two_order }}</p>
{% endif %}
